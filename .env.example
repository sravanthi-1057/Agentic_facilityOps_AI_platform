# Application Environment
ENV=development
PORT=8000
IS_SIMULATED=true

# MySQL Database Configuration
# If MySQL server is not running, the application automatically falls back to local SQLite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=facilityops

# MongoDB Configuration
# If MongoDB is not running, the application automatically falls back to local DocumentStore
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=facilityops_raw

# Configurable Energy Tariffs & Carbon Emission Factors
ELECTRICITY_TARIFF_PER_KWH=0.14
WATER_TARIFF_PER_LITRE=0.004
CARBON_FACTOR_KG_PER_KWH=0.42

# Optional LLM API Configuration (Agent runs 100% deterministically without an API key)
OPENAI_API_KEY=
GEMINI_API_KEY=
